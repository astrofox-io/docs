{
  "$schema": "./node_modules/@umami/shiso/docs.schema.json",
  "theme": "shiso",
  "name": "ASTROFOX",
  "description": "Create audio-reactive motion graphics and export them as images or video.",
  "colors": {
    "primary": "#8b5cf6"
  },
  "logo": "/logo.png",
  "favicon": "/icon.svg",
  "pages": [
    {
      "path": "/",
      "page": "home"
    }
  ],
  "appearance": {
    "default": "dark"
  },
  "search": {
    "prompt": "Search Astrofox docs"
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "navbar": {
    "links": [
      {
        "icon": "github",
        "ariaLabel": "GitHub",
        "href": "https://github.com/astrofox-io/astrofox"
      }
    ]
  },
  "footer": {
    "socials": [
      {
        "icon": "github",
        "ariaLabel": "GitHub",
        "href": "https://github.com/astrofox-io/astrofox"
      },
      {
        "icon": "x",
        "ariaLabel": "X",
        "href": "https://x.com/astrofox_io"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "collapsible": false,
            "pages": [
              { "page": "index", "title": "Introduction" },
              "getting-started"
            ]
          },
          {
            "group": "Interface",
            "root": "interface",
            "collapsible": false,
            "pages": [
              "interface/app-bar-and-actions",
              "interface/layers-panel",
              "interface/reactors-panel",
              "interface/stage",
              "interface/controls-panel",
              "interface/player-and-status"
            ]
          },
          {
            "group": "Create",
            "collapsible": false,
            "pages": ["projects", "audio", "scenes-and-layers", "reactors"]
          },
          {
            "group": "Export",
            "collapsible": false,
            "pages": ["exporting", "desktop-app"]
          },
          {
            "group": "Plugins",
            "collapsible": false,
            "pages": ["plugins", "plugin-authoring", "plugin-runtimes", "plugin-reference"]
          },
          {
            "group": "Help",
            "collapsible": false,
            "pages": ["troubleshooting", "upgrading-from-v1", "development"]
          }
        ]
      },
      {
        "tab": "Downloads",
        "pages": ["downloads"]
      },
      {
        "tab": "Changelog",
        "pages": ["changelog"]
      }
    ]
  }
}
